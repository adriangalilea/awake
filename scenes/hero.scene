# The value in one breath: an agent is at work, ⌃⌥⌘A turns awake on, the lid
# closes, time passes, and the work is further along when it opens.
clock 22:40 · battery 76 · floor 15
agent claude ~/billing
agent prompt "Migrate billing to the v2 API. Make no mistakes."
wait 5000
agent say "On it. This touches every billing module, so it will take a while."
agent tool Read "src/billing/client.ts" "Read 412 lines"
agent tool Bash "rg -l 'api/v1' src" "src/billing/client.ts" "src/billing/invoices.ts" "src/billing/refunds.ts"
caption "Your agent has hours of work ahead."

key
caption "Press ⌃⌥⌘A to keep your Mac awake."
lid close
time +1h50m · battery 58
caption "Close the lid and walk away."
agent tool Update "src/billing/client.ts" "Updated src/billing/client.ts with 212 additions and 98 removals"
agent tool Update "src/billing/invoices.ts" "Updated src/billing/invoices.ts with 64 additions and 41 removals"
agent tool Update "src/billing/refunds.ts" "Updated src/billing/refunds.ts with 37 additions and 22 removals"
agent tool Bash "npm test" "1,281 passed, 3 failed"
agent tool Update "src/billing/refunds.ts" "Updated src/billing/refunds.ts with 6 additions and 2 removals"
agent tool Bash "npm test" "1,284 passed, 0 failed"
agent done "Billing is on the v2 API and all 1,284 tests pass."
lid open
caption "It kept working the whole time."
