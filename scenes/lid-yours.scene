# A coding agent asks to keep working with the lid closed. You grant it from the
# menu, close the lid and leave; when the work ends, the Mac sleeps on its own.
clock 21:04 · battery 64 · floor 15
process 4127 claude

caption "a long refactor starts, and claude asks awake to hold the Mac"
$ awake -w 4127 --lid
@900 open menu
hover "claude asks: survive lid close"
@700 click "Allow while it runs"

caption "you close the lid and leave"
@900 lid close
@1200 time +2h14m · battery 38

caption "the refactor finishes"
exit 4127

@1200 lid open
$ awake status
