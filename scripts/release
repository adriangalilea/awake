#!/usr/bin/env bash
# scripts/release <clone>: what `ship release` runs (release.json) after a
# person approved these exact commits, in the release's working clone of them: the icon,
# then `ship build` (swift-utils) signs from the release's own keychain,
# notarizes and makes the dmg in dist/. Publishing is `mise run release`'s
# second half, from the checkout.
set -euo pipefail
cd "${1:?usage: scripts/release <clone>}"
# The clone is the approved commits: its mise.toml is the one approved.
export MISE_TRUSTED_CONFIG_PATHS="$PWD"
mise run icon
mise run release:build
